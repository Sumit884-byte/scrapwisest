#   Super / Ultra → us-central1
# NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# NEBIUS_NANO_BASE_URL=https://api.tokenfactory.eu-north1.nebius.com/v1/
# NEBIUS_REASONING_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

