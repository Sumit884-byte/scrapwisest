# LLM Provider: "xkiro" (free Qwen models) or "nebius" (Nemotron models).
# If this provider's key is empty, the app uses the other key when present.
LLM_PROVIDER=nebius

# xKiro API Gateway — https://xkiro.com/dashboard/api-keys (free, no card needed)
XKIRO_API_KEY=
# XKIRO_BASE_URL=https://api.xkiro.com/v1
# XKIRO_FAST_MODEL=qwen/qwen3.8-omni-flash
# XKIRO_EVERYDAY_MODEL=qwen/qwen3.8-omni-flash:free
# XKIRO_REASONING_MODEL=qwen/qwen3.8-max:free

# Nebius Token Factory — https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Optional. Defaults already match the Token Factory catalog regions:
#   Nano  → eu-north1
#   Super / Ultra → us-central1
# NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# NEBIUS_NANO_BASE_URL=https://api.tokenfactory.eu-north1.nebius.com/v1/
# NEBIUS_REASONING_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Optional. Groq Whisper + photo grading (vision) when the local CNN is missing.
# GROQ_API_KEY=
# GROQ_STT_FIX_MODEL=llama-3.1-8b-instant
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional. Bright Data MCP user token (same as Arka BRIGHTDATA_API_TOKEN).
# Used for low-confidence *price* context only. Does not set the quoted rate.
# https://brightdata.com/cp/setting/users
# BRIGHT_DATA_API_KEY=

# Optional fallback if Bright Data is unset.
# TAVILY_API_KEY=

# Optional. Sarvam Saaras STT + Bulbul TTS for Indian languages.
# SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=transcribe
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=priya

# Optional model-id overrides
# NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Completion caps and spend guards (defaults are already conservative)
# LLM_NANO_MAX_TOKENS=256
# LLM_SUPER_MAX_TOKENS=512
# LLM_ULTRA_MAX_TOKENS=640
# LLM_MAX_INPUT_CHARS=2500
# LLM_MAX_TURNS_PER_MINUTE=12
# LLM_MAX_TURNS_PER_HOUR=60
# LLM_MAX_TURNS_PER_DAY=250
# LLM_MAX_OUTPUT_TOKENS_PER_DAY=80000
